# Copy this file to .env and fill in your real MongoDB Atlas connection string.
# Get it from: Atlas dashboard -> Database -> Connect -> Drivers -> Node.js
# Remember to replace <password> with your actual database user password,
# and add the database name at the end of the path (e.g. /recipe-app).
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-url>/recipe-app?retryWrites=true&w=majority
